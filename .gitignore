# Este repositorio es PÚBLICO: existe para tener minutos de runner de macOS sin
# límite, que es lo que hace falta para firmar y notarizar. Todo lo que se liste
# acá es lo que NO va a estar a la vista de cualquiera.
#
# Antes de agregar un archivo nuevo al repo, la pregunta es si te molestaría que
# lo lea un desconocido. Un archivo que entra en el historial ya no sale.

# ── lo que se vende ──────────────────────────────────────────────────────────
# El mazo y el contenido del bonus viajan CIFRADOS en contenido-cifrado/ y el
# workflow los descifra con el secret MEDIFLASHY_CONTENIDO_KEY. Los originales
# no se suben nunca. Ver scripts/contenido-cifrado.mjs.
/src/main/services/mazosDeRegalo.ts
/scripts/lib/mapa-grupos.mjs

# ── material personal ────────────────────────────────────────────────────────
# Los PDFs de la facultad son apuntes de una persona real y no tienen por qué
# estar en internet. Los usa el arnés e2e, que se corre en la máquina de
# desarrollo, nunca en el runner.
testing documentos/

# Las salidas de QA incluyen las tarjetas generadas de esos apuntes.
.qa/

# ── secretos ─────────────────────────────────────────────────────────────────
# El certificado y su clave viven fuera del proyecto, pero si alguna vez se
# copian acá por comodidad, que no salgan.
*.p12
*.key
*.cer
*.pem
*.b64
*.env
.env*
p12-password*
*.pfx
*.p8
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db
SECRETS*
*credencial*
firma-apple/
*.mfkey
mediflashy-contenido.key
.npmrc

# ── lo que se compila o se descarga ──────────────────────────────────────────
node_modules/
out/
release/
dist/

# Los motores los baja `npm run setup:llama` del release oficial de llama.cpp.
# Son más de 100 MB y no son código nuestro.
resources/llm/

# Los documentos legales y el aviso de licencias los escribe `make:licenses`
# dentro de resources/ al compilar.
resources/*.txt

# ── lo que generan los scripts ───────────────────────────────────────────────
# Los apuntes de regalo salen de scripts/write-bonus.mjs.
recursos-bonus/

# Los cuatro documentos que quedan en la raíz los escriben make:licenses y
# make:instructions. La fuente es scripts/lib/user-docs.mjs.
/INSTRUCCIONES DE INSTALACIÓN.txt
/LICENCIA DE USO.txt
/LICENCIAS DE TERCEROS.txt
/REQUISITOS Y FUNCIONES.txt

# La carpeta que se sube a Drive: 230 MB de instaladores por plataforma.
entregables flashcards/
/* - Entregables/

# Y por las dudas, ningún instalador, esté donde esté: son de más de 100 MB y
# GitHub rechaza el push entero.
*.exe
*.dmg
*.blockmap

# Las guías en PDF y sus .txt los imprime make:pdfs dentro de `npm run drive`.
/recursos-docs/

# ── ruido del sistema ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log

# El libro de referencia de farmacologia: 37 MB y con derechos de autor.
# Se usa para escribir el mazo, NO viaja al repositorio ni al instalador.
goodmangilman-*.pdf
.ref/
