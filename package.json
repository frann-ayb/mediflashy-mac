{
  "name": "mediflashy",
  "productName": "Mediflashy",
  "version": "1.0.0",
  "description": "Farmacología completa en tarjetas para las carreras de la salud, para estudiar con repetición espaciada. 100% en tu computadora.",
  "author": "Digiconocimiento",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/fetch-llama.mjs --optional",
    "setup:llama": "node scripts/fetch-llama.mjs",
    "sync:core": "node scripts/sync-core.mjs",
    "sync:core-write": "node scripts/sync-core.mjs --write",
    "make:licenses": "node scripts/write-licenses.mjs",
    "make:icon": "node scripts/make-icon.mjs",
    "verify:binaries": "node scripts/verify-binaries.mjs",
    "verify:firma-mac": "node scripts/verify-firma-mac.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && npm run verify:ipc && npm run sync:core && electron-vite build",
    "qa": "npm run qa:datos && npm run qa:dosis && npm run qa:forma && npm run qa:mezcla && npm run qa:choques && npm run qa:siembra && npm run qa:scheduler && npm run qa:libre && npm run qa:ingesta && npm run qa:cola && npm run qa:mazos && npm run qa:generacion",
    "qa:ingesta": "node scripts/run-qa.mjs ingesta",
    "qa:datos": "node scripts/run-qa.mjs datos",
    "qa:scheduler": "node scripts/run-qa.mjs scheduler",
    "qa:generacion": "node scripts/run-qa.mjs generacion",
    "qa:generacion-real": "node scripts/run-qa.mjs generacion -- --real",
    "qa:ui": "npm run build && node qa/ui.mjs",
    "build:unpacked": "npm run build && electron-builder --dir --publish never",
    "contenido:cifrar": "node scripts/contenido-cifrado.mjs cifrar",
    "contenido:descifrar": "node scripts/contenido-cifrado.mjs descifrar",
    "contenido:verificar": "node scripts/contenido-cifrado.mjs verificar",
    "build:win": "npm run contenido:verificar && npm run build && npm run verify:binaries && npm run make:icon && npm run make:licenses && electron-builder --win --publish never && npm run make:instructions",
    "build:mac": "npm run build && npm run verify:binaries && npm run make:icon && npm run make:licenses && electron-builder --mac --publish never && npm run verify:firma-mac && npm run make:instructions",
    "make:instructions": "node scripts/write-instructions.mjs",
    "drive": "npm run make:bonus && npm run make:pdfs && node scripts/make-drive-folder.mjs",
    "qa:vista": "npm run build && node qa/vista.mjs",
    "qa:entrega": "node qa/entrega.mjs",
    "qa:bonus": "node scripts/run-qa.mjs bonus",
    "qa:examenes": "node scripts/check-examenes.mjs",
    "qa:autores": "node scripts/check-autores.mjs src/main/services/mazosDeRegalo.ts",
    "make:bonus": "node scripts/write-bonus.mjs",
    "qa:siembra": "node scripts/run-qa.mjs siembra",
    "qa:dosis": "node scripts/run-qa.mjs dosis",
    "qa:forma": "node scripts/run-qa.mjs forma",
    "qa:mezcla": "node scripts/run-qa.mjs mezcla",
    "qa:choques": "node scripts/run-qa.mjs choques",
    "qa:gama": "node scripts/run-qa.mjs gama",
    "qa:cola": "node scripts/run-qa.mjs cola",
    "verify:ipc": "node scripts/verify-ipc.mjs",
    "qa:mazos": "node scripts/run-qa.mjs mazos",
    "qa:libre": "node scripts/run-qa.mjs libre",
    "make:pdfs": "node scripts/run-electron.mjs scripts/make-pdfs.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "3.11.174",
    "ts-fsrs": "^5.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
